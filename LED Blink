// Assign D1 to a read-only variable for clarity
const int LED_PIN = D1;

// The setup function runs once when the board powers on
void setup() {
  // Configure pin D1 as a digital output
  pinMode(LED_PIN, OUTPUT);
}

// The loop function runs continuously
void loop() {
  digitalWrite(LED_PIN, HIGH); // Send 3.3V to D1 (Turn LED ON)
  delay(1000);                 // Wait for 1000 milliseconds (1 second)
  digitalWrite(LED_PIN, LOW);  // Send 0V to D1 (Turn LED OFF)
  delay(1000);                 // Wait for 1 second
}
